<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Туннель и его счётчики. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Проверка утечек обязана посмотреть на мир с двух сторон: из туннеля и
         вне его. Единственный легальный способ направить сокет в конкретную сеть
         — `requestNetwork`, и он требует CHANGE_NETWORK_STATE (замерено на
         устройстве: без разрешения заявка отклоняется SecurityException, а
         экран теряет строку «Сайты видят»). Разрешение обычное, ставится при установке,
         человека не спрашивается; ничего менять в состояние сети приложение им
         не собирается — имя у Android историческое. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- VPN живёт в foreground service; с Android 14 подтип надо объявить. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Обход по приложениям (`AppBypass`) перечисляет пакеты с ленчер-иконкой.
         Это ровно тот запрос, который виден системе без QUERY_ALL_PACKAGES:
         он отдаёт приложения, которые человек сам запускает, а не каталог
         всякой службы. QUERY_ALL_PACKAGES здесь не нужен и не появится. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Резервное копирование уносит state.json, а в нём приватные ключи и
         учётные данные серверов. На iOS этого вопроса нет: там файл живёт в
         песочнице, которая в iCloud не едет. -->
    <application
        android:name=".AnemiaApplication"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Anemia"
        android:supportsRtl="true"
        android:theme="@style/Theme.Anemia">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Долгое нажатие на значок: перенос и обход по приложениям. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Прослойка для нажатия плитки: поднимает или рвёт туннель и
             закрывается. Не обязательна для exports — к ней идут только из
             собственного процесса. -->
        <activity
            android:name=".ui.SessionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Anemia.Quick" />

        <activity
            android:name=".ui.AppsActivity"
            android:exported="false"
            android:label="Мимо VPN: приложения" />

        <!-- Карта: свои входные двери (ярлык и будущая кнопка на экране), а не
             секция основного экрана — экран сейчас занят другим проходом. -->
        <activity
            android:name=".ui.MapActivity"
            android:exported="false"
            android:label="Карта" />

        <!-- Перенос: открывается чужим файлом `.anemia` или ссылкой
             `anemia://sync/…`. Наружу она обязана быть видима — иначе ни
             проводник файлов, ни мессенджер не предложат Anemia. -->
        <activity
            android:name=".ui.TransferActivity"
            android:exported="true"
            android:label="Перенос Anemia">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="anemia" android:host="sync" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- Два типа, а не `*/*`: с `*/*` Anemia предлагалась бы на
                     любую пересылку — картинку, контакт, ссылку. -->
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Отдельный процесс: убийство интерфейса не рвёт туннель, и
             память движка не считается вместе с Compose. -->
        <service
            android:name=".vpn.AnemiaVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:process=":vpn">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <!-- Обоснование specialUse для Play: постоянный туннель. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>

        <!-- Плитка Quick Settings. Экспортирована и защищена системным
             правом: привязать её может только штора, а не первое приложение
             подряд. -->
        <service
            android:name=".vpn.AnemiaTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_anemia"
            android:label="Anemia VPN"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Файл переноса наружу: одноразовое право чтения на один URI,
             каталог файлов с ключами наружу не открывается. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/files" />
        </provider>
    </application>
</manifest>
