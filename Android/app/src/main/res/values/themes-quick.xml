<?xml version="1.0" encoding="utf-8"?>
<!--
  Тема окна-прослойки для нажатия плитки: прозрачная, без строки заголовка и
  без затемнения. Окно нужно только чтобы легально поднять foreground-сервис и
  показать системный диалог согласия — видеть человек должен шторку, а не пустой
  экран.
-->
<resources>
    <style name="Theme.Anemia.Quick" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
