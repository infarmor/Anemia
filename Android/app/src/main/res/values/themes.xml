<?xml version="1.0" encoding="utf-8"?>
<!--
  Тема окна. Палитра и акцент живут в Compose (Material3); отсюда только
  убранная строка заголовка и чёрный фон окна, чтобы между стартом активити
  и первым кадром Compose не мелькало белое.
-->
<resources>
    <style name="Theme.Anemia" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>
</resources>
