@@ -23,6 +23,7 @@
 	ctx             context.Context
 	config          *Config
 	stack           Stack
+	tun             Tun
 	policyManager   policy.Manager
 	dispatcher      routing.Dispatcher
 	tag             string
@@ -95,9 +96,24 @@
 	}
 
 	t.stack = tunStack
+	t.tun = tunInterface
 
 	errors.LogInfo(t.ctx, tunName, " up")
 	return nil
+}
+
+// Close stops the ip stack and releases the interface.
+// Anemia patch: upstream has no Close, so after Instance.Close the stack kept
+// reading the tunnel and an in-process restart raced it for every packet.
+func (t *Handler) Close() error {
+	var errs []error
+	if t.stack != nil {
+		errs = append(errs, t.stack.Close())
+	}
+	if t.tun != nil {
+		errs = append(errs, t.tun.Close())
+	}
+	return errors.Combine(errs...)
 }
 
