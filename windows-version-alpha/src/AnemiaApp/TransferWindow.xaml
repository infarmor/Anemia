<Window x:Class="AnemiaApp.TransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transfer" Width="460" Height="Auto" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgGradient}">
    <ScrollViewer Padding="18,14">
        <StackPanel>
            <!-- Export: the same document the Mac and the phone read. -->
            <Border Style="{DynamicResource CardTile}" Padding="6">
                <StackPanel Margin="10,8">
                    <TextBlock Text="Export" FontSize="13" FontWeight="Medium"
                               Foreground="{DynamicResource Text}" />
                    <TextBlock x:Name="ExportSummary" FontSize="11" Margin="0,2,0,8"
                               Text="This machine's servers and panels, as one file."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextDim}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Save .anemia file…" Click="OnSaveFile" Padding="10,4" />
                        <Button Content="Copy link" Click="OnCopyLink" Padding="10,4" Margin="8,0,0,0" />
                    </StackPanel>
                    <!-- The QR bitmap itself is not drawn here: that needs an
                         encoder this port does not have yet, and a link text the
                         user can paste is honest where a grey box would not be. -->
                    <TextBlock x:Name="LinkText" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextDim}" />
                </StackPanel>
            </Border>

            <Rectangle Style="{DynamicResource Hairline}" Margin="0,12" />

            <!-- Import: preview first, and the Import button only for a bundle
                 that actually adds something. -->
            <Border Style="{DynamicResource CardTile}" Padding="6">
                <StackPanel Margin="10,8">
                    <TextBlock Text="Import" FontSize="13" FontWeight="Medium"
                               Foreground="{DynamicResource Text}" />
                    <TextBlock x:Name="IncomingSummary" FontSize="11" Margin="0,2,0,8"
                               Text="Open a file another device exported, or paste its text."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextDim}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open file…" Click="OnOpenFile" Padding="10,4" />
                        <Button Content="Read clipboard" Click="OnPaste" Padding="10,4" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBox x:Name="IncomingText" MinHeight="54" MaxHeight="120" Margin="0,8,0,0"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11"
                             TextChanged="OnTextChanged" />
                    <CheckBox x:Name="ApplySettingsBox" Content="Take its settings (masking, kill switch)"
                              Margin="0,8,0,0" IsChecked="True" Visibility="Collapsed"
                              Checked="OnPreviewAgain" Unchecked="OnPreviewAgain" />
                    <TextBlock x:Name="PreviewLine" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextDim}" />
                    <Button x:Name="ImportButton" Content="Import" Click="OnImport" Padding="10,4"
                            Margin="0,8,0,0" HorizontalAlignment="Left" IsEnabled="False" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
