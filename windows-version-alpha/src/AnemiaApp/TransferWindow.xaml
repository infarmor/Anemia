<local:AnemiaToolWindow x:Class="AnemiaApp.TransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AnemiaApp"
        Title="Перенос" Width="460" Height="Auto" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowCaptionTitle="True" Background="{DynamicResource BgGradient}">
    <ScrollViewer Padding="18,14" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- Export: the same document the Mac and the phone read. -->
            <Border Style="{DynamicResource CardTile}" Padding="6">
                <StackPanel Margin="10,8">
                    <TextBlock Text="Экспорт" FontSize="13" FontWeight="Medium"
                               Foreground="{DynamicResource Text}" />
                    <TextBlock x:Name="ExportSummary" FontSize="11" Margin="0,2,0,8"
                               Text="Серверы, подписки и настройки в одном файле"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextDim}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{DynamicResource Btn}" Content="Сохранить файл…" Click="OnSaveFile" Padding="10,4" />
                        <Button Style="{DynamicResource Btn}" Content="Копировать ссылку" Click="OnCopyLink" Padding="10,4" Margin="8,0,0,0" />
                        <Button Style="{DynamicResource Btn}" Content="QR-код" Click="OnShowQr" Padding="10,4" Margin="8,0,0,0" />
                    </StackPanel>
                    <Image x:Name="TransferQr" Visibility="Collapsed" Width="220" Height="220" Margin="0,10,0,0"
                           HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="NearestNeighbor"
                           AutomationProperties.Name="QR-код переноса серверов и настроек" />
                    <TextBlock x:Name="LinkText" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextDim}" />
                </StackPanel>
            </Border>

            <Rectangle Style="{DynamicResource Hairline}" Margin="0,12" />

            <!-- Import: preview first, and the Import button only for a bundle
                 that actually adds something. -->
            <Border Style="{DynamicResource CardTile}" Padding="6">
                <StackPanel Margin="10,8">
                    <TextBlock Text="Импорт" FontSize="13" FontWeight="Medium"
                               Foreground="{DynamicResource Text}" />
                    <TextBlock x:Name="IncomingSummary" FontSize="11" Margin="0,2,0,8"
                               Text="Откройте файл или вставьте ссылку переноса"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextDim}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{DynamicResource Btn}" Content="Открыть файл…" Click="OnOpenFile" Padding="10,4" />
                        <Button Style="{DynamicResource Btn}" Content="Вставить из буфера" Click="OnPaste" Padding="10,4" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBox x:Name="IncomingText" MinHeight="54" MaxHeight="120" Margin="0,8,0,0"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Style="{DynamicResource Field}" VerticalScrollBarVisibility="Hidden"
                             AutomationProperties.Name="Ссылка переноса"
                             FontFamily="Consolas" FontSize="11"
                             TextChanged="OnTextChanged" />
                    <CheckBox x:Name="ApplySettingsBox" Content="Применить настройки из файла"
                              Margin="0,8,0,0" IsChecked="True" Visibility="Collapsed"
                              Foreground="{DynamicResource Text}"
                              Checked="OnPreviewAgain" Unchecked="OnPreviewAgain" />
                    <TextBlock x:Name="PreviewLine" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextDim}" />
                    <Button x:Name="ImportButton" Style="{DynamicResource BtnPrimary}"
                            Content="Импортировать" Click="OnImport" Padding="10,4"
                            Margin="0,8,0,0" HorizontalAlignment="Left" IsEnabled="False" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:AnemiaToolWindow>
