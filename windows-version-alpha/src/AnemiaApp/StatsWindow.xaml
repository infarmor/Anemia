<local:AnemiaToolWindow x:Class="AnemiaApp.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AnemiaApp"
        Title="Статистика" Width="540" Height="520" MinWidth="440" MinHeight="410"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Ground}">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Статистика" FontFamily="{StaticResource DisplayFont}"
                   FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,0,0,12" />
        <TabControl Background="{DynamicResource Ground}" BorderThickness="0" Foreground="{DynamicResource Text}">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Chip" MinWidth="96" CornerRadius="7" Padding="12,6"
                                        Background="{DynamicResource Card}" Margin="0,0,4,8">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource CardHi}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem Header="Трафик">
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel>
                        <UniformGrid Columns="2" Margin="0,5,0,10">
                            <Border Style="{DynamicResource CardTile}" Padding="12" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Сегодня" Foreground="{DynamicResource TextDim}" />
                                    <TextBlock x:Name="TodayValue" FontSize="21" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text}" />
                                    <TextBlock x:Name="TodayDetail" Foreground="{DynamicResource TextDim}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{DynamicResource CardTile}" Padding="12" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Этот месяц" Foreground="{DynamicResource TextDim}" />
                                    <TextBlock x:Name="MonthValue" FontSize="21" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text}" />
                                    <TextBlock x:Name="MonthDetail" Foreground="{DynamicResource TextDim}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Style="{DynamicResource CardTile}" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Последние 14 дней" Foreground="{DynamicResource Text}" />
                                <ItemsControl x:Name="Days" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="14" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="62" ToolTip="{Binding Detail}" AutomationProperties.Name="{Binding Detail}">
                                                <Border Height="{Binding Height}" VerticalAlignment="Bottom" Margin="3,0"
                                                        CornerRadius="3,3,0,0" Background="{DynamicResource Accent}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource CardTile}" Padding="12">
                            <StackPanel>
                                <TextBlock Text="По серверам" Foreground="{DynamicResource Text}" />
                                <TextBlock x:Name="NoTraffic" Text="Пока нет данных" Foreground="{DynamicResource TextDim}"
                                           Margin="0,5,0,0" />
                                <ItemsControl x:Name="TopServers">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,7,0,0">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Total}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text}" Margin="12,0,0,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Text}" />
                                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextDim}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Button Style="{DynamicResource Btn}" Content="Сбросить статистику" Click="OnReset"
                                HorizontalAlignment="Right" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Скорость">
                <StackPanel Margin="0,5,0,0">
                    <Border Style="{DynamicResource CardTile}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Тест скорости" Foreground="{DynamicResource Text}" FontWeight="SemiBold"
                                       FontSize="16" />
                            <TextBlock x:Name="SpeedPath" Margin="0,4,0,12" Foreground="{DynamicResource TextDim}"
                                       TextWrapping="Wrap" />
                            <Grid Width="200" Height="105" HorizontalAlignment="Center">
                                <Path Data="M12,96 A88,88 0 0 1 188,96" Stroke="{DynamicResource Stroke}"
                                      StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Path x:Name="SpeedArc" Stroke="{DynamicResource Accent}" StrokeThickness="5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <TextBlock x:Name="SpeedValue" Text="—" Foreground="{DynamicResource Accent}" FontSize="28"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                           Margin="0,0,0,7" />
                            </Grid>
                            <TextBlock x:Name="SpeedPhase" Text="Cloudflare" Foreground="{DynamicResource TextDim}"
                                       HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <UniformGrid Columns="3">
                                <TextBlock x:Name="LatencyResult" Text="Задержка —" Foreground="{DynamicResource Text}" />
                                <TextBlock x:Name="DownloadResult" Text="Приём —" Foreground="{DynamicResource Text}" />
                                <TextBlock x:Name="UploadResult" Text="Отдача —" Foreground="{DynamicResource Text}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Button x:Name="SpeedButton" Style="{DynamicResource BtnPrimary}" Content="Начать" Click="OnSpeed"
                            HorizontalAlignment="Right" Margin="0,12,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</local:AnemiaToolWindow>
