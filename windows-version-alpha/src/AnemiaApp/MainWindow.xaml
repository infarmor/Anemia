<Window x:Class="AnemiaApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AnemiaApp"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Anemia" Width="580" Height="630" MinWidth="520" MinHeight="540"
        WindowStyle="None" WindowStartupLocation="CenterScreen" Background="{DynamicResource Ground}">
    <shell:WindowChrome.WindowChrome>
        <!-- With zero glass, WindowChrome passes this value to the native region as the ellipse diameter. -->
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="32" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
        <Style x:Key="ToolbarSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="track" Height="22" CornerRadius="11" Background="{DynamicResource ToolbarSwitchTrack}"
                                    BorderBrush="{DynamicResource ToolbarSwitchEdge}" BorderThickness="1" />
                            <Ellipse x:Name="knob" Width="19" Height="19" HorizontalAlignment="Left"
                                     VerticalAlignment="Center" Margin="2,0,0,0" Fill="{DynamicResource ToolbarSwitchKnob}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentDim}" />
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="knob" Property="Margin" Value="19,0,0,0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="knob" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="WindowFrame" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="16" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
                <Grid MinHeight="221">
                    <Border Height="221" VerticalAlignment="Top">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                <GradientStop Color="White" Offset="0.08" />
                                <GradientStop Color="White" Offset="0.92" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                        <local:ConnectionMap x:Name="WorldMap"
                                             Land="{DynamicResource MapLand}" Accent="{DynamicResource Accent}">
                            <local:ConnectionMap.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="White" Offset="0" />
                                    <GradientStop Color="White" Offset="0.5" />
                                    <GradientStop Color="#2EFFFFFF" Offset="0.8" />
                                    <GradientStop Color="#00FFFFFF" Offset="0.97" />
                                </LinearGradientBrush>
                            </local:ConnectionMap.OpacityMask>
                        </local:ConnectionMap>
                    </Border>
                    <Grid VerticalAlignment="Top" Height="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                            <Rectangle Width="14" Height="14" Margin="0,0,6,0" Fill="{DynamicResource Accent}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Anemia;component/Assets/anemia-mark.png" Stretch="Uniform" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Anemia" FontFamily="{StaticResource DisplayFont}" FontSize="16"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Button x:Name="LeakCheckButton" Style="{StaticResource ToolbarButton}" Click="OnOpenLeakTest"
                                    AutomationProperties.Name="Проверка утечек" ToolTip="Проверка утечек">
                                <Path Width="13" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextDim}"
                                      StrokeThickness="1.3" StrokeLineJoin="Round"
                                      Data="M6,1 L12,3 L12,8 Q12,12 6,14 Q0,12 0,8 L0,3 Z M4,7 H8 V10 H4 Z M5,7 V6 A1,1 0 0 1 7,6 V7" />
                            </Button>
                            <ToggleButton x:Name="ConnectSwitch" Style="{StaticResource ToolbarSwitch}"
                                          shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                          AutomationProperties.Name="VPN" ToolTipService.ShowOnDisabled="True"
                                          VerticalAlignment="Center" Margin="8,0" Click="OnConnectToggle" />
                            <Button x:Name="SettingsButton" Style="{StaticResource ToolbarButton}" Click="OnOpenSettings"
                                    AutomationProperties.Name="Настройки" ToolTip="Настройки">
                                <Path Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource TextDim}"
                                      StrokeThickness="1.4" StrokeLineJoin="Round"
                                      Data="M9,0 L11,0 L12,3 L15,4 L18,3 L20,6 L18,9 L18,11 L20,14 L18,17 L15,16 L12,17 L11,20 L9,20 L8,17 L5,16 L2,17 L0,14 L2,11 L2,9 L0,6 L2,3 L5,4 L8,3 Z M10,7 A3,3 0 1 1 10,13 A3,3 0 1 1 10,7 Z" />
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="MinimizeWindowButton" Style="{StaticResource WindowCaptionButton}" Content="&#xE921;" Click="OnMinimizeWindow"
                                    AutomationProperties.Name="Свернуть" ToolTip="Свернуть" />
                            <Button x:Name="MaximizeWindowButton" Style="{StaticResource WindowMaximizeCaptionButton}" Click="OnMaximizeWindow" />
                            <Button x:Name="CloseWindowButton" Style="{StaticResource WindowCloseCaptionButton}" Content="&#xE8BB;" Click="OnCloseWindow"
                                    AutomationProperties.Name="Закрыть" ToolTip="Закрыть" />
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="MapLegendGroup" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20,0,20,14">
                        <Ellipse Width="7" Height="7" Stroke="{DynamicResource Accent}" Opacity="0.75" Margin="0,0,5,0" />
                        <TextBlock x:Name="MapLegend" Foreground="{DynamicResource TextDim}" FontSize="11" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom" Margin="20,0,115,14">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="StatusGlyph" Width="22" Height="24" Stretch="Uniform" Margin="0,0,10,0"
                              Stroke="{DynamicResource TextDim}" StrokeThickness="1.6" StrokeLineJoin="Round"
                              VerticalAlignment="Center" Data="M12,1 L22,5 L22,12 Q22,19 12,24 Q2,19 2,12 L2,5 Z M7,8 L17,17" />
                        <TextBlock x:Name="StatusText" Text="Не подключено" FontSize="28"
                                   FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <TextBlock x:Name="StatusDetail" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextDim}" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="SessionText" Foreground="{DynamicResource TextDim}"
                                   FontSize="12" Visibility="Collapsed" />
                        <TextBlock x:Name="PingText" Margin="8,0,0,0" Foreground="{DynamicResource TextDim}"
                                   FontSize="12" Visibility="Collapsed" />
                        <TextBlock x:Name="RateText" Margin="8,0,0,0" Foreground="{DynamicResource TextDim}"
                                   FontSize="12" Visibility="Collapsed" />
                    </StackPanel>
                    </StackPanel>
                </Grid>

            <ScrollViewer x:Name="DashboardScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,0,20,20">
                <DockPanel>
                    <Button x:Name="PingBtn" DockPanel.Dock="Right" Style="{DynamicResource PillButton}" Margin="8,0,0,0"
                            Width="36" Height="36" Padding="0" Click="OnPingAll" ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="Замерить задержку">
                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource Text}" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M7,1 A6,6 0 1 1 7,13 A6,6 0 1 1 7,1 Z M7,10 V7 L9,5" />
                    </Button>
                    <Button x:Name="FastestBtn" DockPanel.Dock="Right" Style="{DynamicResource PillButton}" Margin="8,0,0,0"
                            Width="36" Height="36" Padding="0" Click="OnPickBest" ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="Лучший сервер">
                        <Path Width="12" Height="17" Stretch="Uniform" Fill="{DynamicResource Text}"
                              Data="M11,0 L2,11 H7 L5,20 L15,8 H10 Z" />
                    </Button>
                    <Button Click="OnOpenServers" Style="{DynamicResource PillButton}" AutomationProperties.Name="Выбрать сервер"
                            MinHeight="46" Padding="12,5" HorizontalContentAlignment="Stretch">
                        <DockPanel LastChildFill="True">
                            <Path DockPanel.Dock="Right" Width="7" Height="11" Margin="8,0,0,0" Stretch="Uniform"
                                  Stroke="{DynamicResource TextDim}" StrokeThickness="1.6" VerticalAlignment="Center"
                                  Data="M0,3 L3,0 L6,3 M0,7 L3,10 L6,7" />
                            <TextBlock DockPanel.Dock="Right" x:Name="ServerPing" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock x:Name="ServerName" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ServerSubtitle" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </DockPanel>

                <Button x:Name="UsageButton" Margin="0,16" Click="OnOpenStats" Cursor="Hand"
                        AutomationProperties.Name="Статистика трафика и тест скорости" ToolTip="Статистика и тест скорости">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="StatsHitArea" BorderThickness="1" CornerRadius="6" Background="Transparent">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="StatsHitArea" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,18,0">
                        <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Idle}" Margin="0,0,8,0">
                            <TextBlock Text="↓" FontSize="15" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock x:Name="DownRate" Foreground="{DynamicResource Text}" FontSize="14" FontWeight="SemiBold" Text="0 Б/с" />
                            <TextBlock x:Name="DownTotal" Foreground="{DynamicResource TextDim}" FontSize="11" Text="0 Б" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,18,0">
                        <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Idle}" Margin="0,0,8,0">
                            <TextBlock Text="↑" FontSize="15" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock x:Name="UpRate" Foreground="{DynamicResource Text}" FontSize="14" FontWeight="SemiBold" Text="0 Б/с" />
                            <TextBlock x:Name="UpTotal" Foreground="{DynamicResource TextDim}" FontSize="11" Text="0 Б" />
                        </StackPanel>
                    </StackPanel>
                    <local:TrafficSparkline x:Name="TrafficPlot" Grid.Column="2" Height="34" VerticalAlignment="Center" />
                </Grid>
                </Button>

                <Border Style="{DynamicResource CardTile}" BorderThickness="0" Padding="12,2">
                    <StackPanel>
                        <DockPanel Margin="0,8">
                            <ToggleButton DockPanel.Dock="Right" x:Name="KillSwitchSwitch" Style="{DynamicResource Switch}"
                                          AutomationProperties.Name="Kill switch" Click="OnKillSwitchToggle" Margin="12,0,0,0" />
                            <Border DockPanel.Dock="Left" Style="{DynamicResource ProtectionIcon}"
                                    Tag="{Binding IsChecked, ElementName=KillSwitchSwitch}">
                                <Path Width="11" Height="13" Stretch="Uniform"
                                      Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                                      Data="F0 M6,0 L12,2.4 V7.4 C12,10.5 9.3,13.1 6,14.4 C2.7,13.1 0,10.5 0,7.4 V2.4 Z
                                            M3.6,7.1 H4.4 V6 A1.6,1.6 0 0 1 7.6,6 V7.1 H8.4 V10.4 H3.6 Z
                                            M5.3,7.1 H6.7 V6 A0.7,0.7 0 0 0 5.3,6 Z" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Kill switch" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Text}" />
                                <TextBlock x:Name="KillSwitchCaption" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{DynamicResource Hairline}" Margin="38,0,0,0" />
                        <DockPanel Margin="0,8">
                            <ComboBox DockPanel.Dock="Right" x:Name="MaskingBox" Style="{DynamicResource MiniCombo}"
                                      MinWidth="100" SelectionChanged="OnMaskingChanged" Margin="12,0,0,0"
                                      AutomationProperties.Name="Профиль маскирования" />
                            <Border DockPanel.Dock="Left" xmlns:core="clr-namespace:AnemiaCore;assembly=AnemiaCore">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource ProtectionIcon}">
                                        <Setter Property="Tag" Value="True" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedValue, ElementName=MaskingBox}" Value="{x:Null}">
                                                <Setter Property="Tag" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedValue, ElementName=MaskingBox}" Value="{x:Static core:MaskingProfile.Off}">
                                                <Setter Property="Tag" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Width="20" Height="15">
                                    <Path Width="11" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Uniform"
                                          Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                                          Data="F0 M0,2 L10,0 L11,5 C11.5,8 9.6,10.7 7.2,12 C4.5,11.7 2.2,9.6 1.6,6.8 Z
                                                M2.9,4.8 Q3.9,3.4 5.1,4.4 L5.2,5.1 L3,5.5 Z M6.9,4 Q7.8,2.7 9,3.7 L9.1,4.3 L7,4.7 Z
                                                M4.4,7.5 Q6.7,8.2 9,6.5 Q8.4,9.5 6.7,9.6 Q5.2,9.6 4.4,7.5 Z" />
                                    <Path Width="11" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stretch="Uniform"
                                          Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                                          Data="F0 M2.1,0 L12,2.3 L10.2,7.2 C9.3,9.8 6.8,11.8 4.1,12 C1.7,10.5 0,7.6 0.7,4.9 Z
                                                M2.9,3.4 L5.1,4 L5,4.7 Q3.8,5.5 2.8,4.2 Z M7,4.5 L9.2,5.1 L9,5.8 Q7.8,6.5 6.9,5.3 Z
                                                M3.3,8.5 Q4.5,6.5 6,6.8 Q7.5,7.1 7.9,9.7 Q5.8,8.1 3.3,8.5 Z" />
                                </Grid>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Маскирование" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Text}" />
                                <TextBlock Text="Профиль подключения Xray" Margin="0,2,0,0" FontSize="11"
                                           Foreground="{DynamicResource TextDim}" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{DynamicResource Hairline}" Margin="38,0,0,0" />
                        <DockPanel Margin="0,8">
                            <ToggleButton DockPanel.Dock="Right" x:Name="AdBlockSwitch" Style="{DynamicResource Switch}"
                                          AutomationProperties.Name="Блокировать рекламу" Click="OnAdBlockToggle" Margin="12,0,0,0" />
                            <Border DockPanel.Dock="Left" Style="{DynamicResource ProtectionIcon}"
                                    Tag="{Binding IsChecked, ElementName=AdBlockSwitch}">
                                <Path Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.5"
                                      Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                                      Data="M7,0 A7,7 0 1 1 6.99,0 Z M2,2 L12,12" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Без рекламы" FontSize="13" Foreground="{DynamicResource Text}" />
                                <TextBlock Text="AdGuard DNS при следующем подключении" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{DynamicResource Hairline}" Margin="38,0,0,0" />
                        <DockPanel Margin="0,8">
                            <Button DockPanel.Dock="Right" Style="{DynamicResource Btn}" Content="Проверить…" Padding="10,5"
                                    Click="OnOpenLeakTest" Margin="12,0,0,0" />
                            <Border x:Name="LeakTile" DockPanel.Dock="Left" Style="{DynamicResource ProtectionIcon}">
                                <Path Width="14" Height="11" Stretch="Uniform" StrokeThickness="1.5"
                                      Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                                      Data="M0,6 Q7,-2 14,6 Q7,14 0,6 Z M5,6 A2,2 0 1 1 9,6 A2,2 0 1 1 5,6 Z M1,0 L13,12" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Проверка утечек" FontSize="13" Foreground="{DynamicResource Text}" />
                                <TextBlock x:Name="LeakCaption" Text="Какой IP видят сайты, не утекают ли DNS и IPv6" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{DynamicResource Hairline}" Margin="38,0,0,0" />
                        <DockPanel Margin="0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" Fill="{Binding Foreground, ElementName=RouteMode}" />
                                <TextBlock x:Name="RouteMode" Text="Отключён" Foreground="{DynamicResource TextDim}"
                                           FontWeight="Medium" FontSize="13" />
                            </StackPanel>
                            <Border x:Name="RouteTile" DockPanel.Dock="Left" Style="{DynamicResource ProtectionIcon}">
                                <Path Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.5"
                                      Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                                      Data="M6,13 V7 L1,2 M6,7 L11,2 M1,2 H4 M11,2 H8" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Маршрутизация" FontSize="13" Foreground="{DynamicResource Text}" />
                                <TextBlock Text="Куда идёт трафик" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource TextDim}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
