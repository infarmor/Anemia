<Window x:Class="AnemiaApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anemia" Width="600" Height="580" MinWidth="560" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgGradient}">
    <!-- Port of the macOS RootView hierarchy, top → bottom:
         act (pick a server), act again (fastest / re-ping), then read
         (traffic + protection), then trust (log). The top bar owns the
         single connect control, next to the brand — like the macOS window. -->
    <DockPanel>
        <!-- Top bar: brand + status cluster + connect switch + settings -->
        <Border DockPanel.Dock="Top" Padding="18,10" BorderBrush="{DynamicResource Stroke}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Anemia" FontFamily="{StaticResource DisplayFont}"
                           FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                           VerticalAlignment="Center" />
                <!-- Status beside the brand: lamp + status, and while connected
                     the session timer, live latency and rate on the same line.
                     Full error rides in the tooltip (statusDetail). -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0"
                            VerticalAlignment="Center" ToolTipService.InitialShowDelay="100">
                    <StackPanel.ToolTip>
                        <ToolTip x:Name="StatusTip" />
                    </StackPanel.ToolTip>
                    <Ellipse x:Name="StatusDot" Width="8" Height="8"
                             Fill="{DynamicResource TextDim}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Margin="7,0,0,0" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                               Text="Not connected" />
                    <TextBlock x:Name="SessionText" Margin="7,0,0,0" FontFamily="{StaticResource MetricFont}"
                               FontSize="12" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                               Visibility="Collapsed" Text="" />
                    <TextBlock x:Name="PingText" Margin="7,0,0,0" FontFamily="{StaticResource MetricFont}"
                               FontSize="12" VerticalAlignment="Center" Visibility="Collapsed" Text="" />
                    <TextBlock x:Name="RateText" Margin="7,0,0,0" FontFamily="{StaticResource MetricFont}"
                               FontSize="12" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                               Visibility="Collapsed" Text="" />
                </StackPanel>
                <ToggleButton x:Name="ConnectSwitch" Grid.Column="2" Style="{DynamicResource Switch}"
                              VerticalAlignment="Center" Click="OnConnectToggle"
                              ToolTip="Connect (⌘↩ on macOS — click here)" />
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="TransferBtn" Style="{DynamicResource Btn}"
                            Padding="8,7" VerticalAlignment="Center"
                            Content="⇅" FontSize="13" Click="OnOpenTransfer"
                            ToolTip="Transfer servers and settings to another device" />
                    <Button x:Name="SettingsBtn" Style="{DynamicResource Btn}"
                            Padding="8,7" Margin="8,0,0,0" VerticalAlignment="Center"
                            Content="⚙" FontSize="13" Click="OnOpenSettings"
                            ToolTip="Settings" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,14,20,16">
            <StackPanel>
                <!-- Server card (tap → picker sheet) -->
                <Border Style="{DynamicResource SubTile}" Padding="15" Cursor="Hand"
                        MouseLeftButtonUp="OnOpenServers" Background="{DynamicResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                                Background="{DynamicResource CardHi}" VerticalAlignment="Center">
                            <TextBlock Text="🖧" FontSize="15" Foreground="{DynamicResource TextDim}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ServerName" Text="No server selected" FontSize="13"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ServerSubtitle" Text="Tap to import or choose a server"
                                       FontSize="11" Foreground="{DynamicResource TextDim}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="ServerPing" FontFamily="{StaticResource MetricFont}"
                                   FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextDim}" Text="" />
                        <TextBlock Grid.Column="3" Text="›" FontSize="14" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Quick actions -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="FastestBtn" Grid.Column="0" Style="{DynamicResource Btn}"
                            Content="⚡  Fastest" Click="OnPickBest" />
                    <Button x:Name="PingBtn" Grid.Column="2" Style="{DynamicResource Btn}"
                            Content="Ping" Click="OnPingAll" />
                </Grid>

                <!-- Traffic: both directions share ONE tile -->
                <Border Style="{DynamicResource CardTile}" Margin="0,10,0,0" x:Name="StatsTile">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="↓" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                            <StackPanel Margin="9,0,0,0">
                                <TextBlock x:Name="DownRate" FontFamily="{StaticResource MetricFont}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                           Text="0 B/s" />
                                <TextBlock x:Name="DownTotal" FontFamily="{StaticResource MetricFont}"
                                           FontSize="11" Foreground="{DynamicResource TextDim}" Text="0 B" />
                            </StackPanel>
                        </StackPanel>
                        <Rectangle Grid.Column="1" Width="1" Height="20" Fill="{DynamicResource Stroke}"
                                   VerticalAlignment="Center" Margin="14,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="↑" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" />
                            <StackPanel Margin="9,0,0,0">
                                <TextBlock x:Name="UpRate" FontFamily="{StaticResource MetricFont}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                           Text="0 B/s" />
                                <TextBlock x:Name="UpTotal" FontFamily="{StaticResource MetricFont}"
                                           FontSize="11" Foreground="{DynamicResource TextDim}" Text="0 B" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Protection tile: kill switch + masking + traffic mode -->
                <Border Style="{DynamicResource CardTile}" Margin="0,10,0,0" Padding="6">
                    <StackPanel>
                        <Grid Margin="10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Kill switch" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Text}" />
                                <TextBlock x:Name="KillSwitchCaption" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"
                                           Text="Fail-closed — block traffic if the tunnel drops" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="KillSwitchSwitch" Style="{DynamicResource Switch}"
                                          VerticalAlignment="Center" Click="OnKillSwitchToggle"
                                          ToolTip="Stop all traffic if the VPN connection is lost, until you reconnect" />
                        </Grid>
                        <Rectangle Style="{DynamicResource Hairline}" />
                        <Grid Margin="10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DPI masking" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Text}" />
                                <TextBlock x:Name="MaskingCaption" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"
                                           Text="Fragment + junk — recommended" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="MaskingBox" Style="{DynamicResource MiniCombo}"
                                      VerticalAlignment="Center" MinWidth="88"
                                      SelectionChanged="OnMaskingChanged"
                                      ToolTip="How the connection is disguised from DPI (fragmentation, junk, stealth SNI)" />
                        </Grid>
                        <Rectangle Style="{DynamicResource Hairline}" />
                        <Grid Margin="10,8" ToolTip="How traffic leaves the machine">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Traffic mode" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Text}" />
                                <TextBlock Text="How traffic leaves the machine" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextDim}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ModeDot" Width="6" Height="6"
                                         Fill="{DynamicResource TextDim}" Margin="0,0,5,0" />
                                <TextBlock x:Name="ModeText" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDim}" Text="Off" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Log tail -->
                <Border Style="{DynamicResource CardTile}" Margin="0,10,0,0" Height="120" Padding="10">
                    <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent"
                             Foreground="{DynamicResource TextDim}" BorderThickness="0"
                             FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Hidden" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>