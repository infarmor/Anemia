<Window x:Class="AnemiaApp.ServersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Servers" Width="520" Height="480" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgGradient}">
    <!-- Port of the macOS ServersSheet: radio-dot rows (name + proto·address
         subtitle + ping badge + trash), and a bottom import bar with the
         share-link field, subscriptions and the two quick probes. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="18,12"
                BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ImportBox" Style="{DynamicResource Field}"
                             KeyDown="OnImportKeyDown" VerticalContentAlignment="Center"
                             ToolTip="vless:// vmess:// ss:// trojan:// link — or a subscription URL" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Style="{DynamicResource BtnPrimary}" Content="Import"
                                Click="OnImport" Padding="14,8" />
                        <Button Style="{DynamicResource Btn}" Content="+ Sub" Click="OnAddSubscription"
                                Padding="12,8" Margin="6,0,0,0"
                                ToolTip="Treat the pasted URL as a subscription and refresh it on a schedule" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="PingAllBtn" Style="{DynamicResource Btn}"
                            Content="Ping all" Click="OnPingAll" />
                    <Button Grid.Column="2" x:Name="BestBtn" Style="{DynamicResource Btn}"
                            Content="⚡ Fastest" Click="OnPickBest" />
                    <Button Grid.Column="4" Style="{DynamicResource Btn}"
                            Content="↻ Refresh subs" Click="OnRefreshSubs"
                            ToolTip="Re-fetch every subscription now" />
                </Grid>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
            <ItemsControl x:Name="ServerList" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource SubTile}" Margin="0,0,0,8" Padding="12,10"
                                Cursor="Hand" MouseLeftButtonUp="OnRowClick">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="10" Height="10" Margin="2,0,10,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding DotBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextDim}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Ping}"
                                           Foreground="{Binding PingBrush}"
                                           FontFamily="{StaticResource MetricFont}" FontSize="12"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                <Button Grid.Column="3" Content="✕" FontSize="11" Padding="6,3"
                                        Margin="10,0,0,0" VerticalAlignment="Center"
                                        Style="{DynamicResource Btn}" Click="OnRemove"
                                        ToolTip="Remove this server" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>