<local:AnemiaToolWindow x:Class="AnemiaApp.ServersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AnemiaApp"
        Title="Серверы" Width="568" Height="568" MinWidth="484" MinHeight="430"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Ground}"
        UseLayoutRounding="True">
    <local:AnemiaToolWindow.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIf" />
        <Style x:Key="PickerAction" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="ServerSelection" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style x:Key="QuotaProgress" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Background" Value="{DynamicResource Stroke}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left" CornerRadius="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:AnemiaToolWindow.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="18,15,18,10">
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{DynamicResource Btn}" Padding="11,5"
                        Content="Добавить…" Click="OnShowImport" />
                <TextBlock Text="Серверы" FontFamily="{StaticResource DisplayFont}" FontSize="25"
                           Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
            </DockPanel>

            <Border x:Name="ImportPanel" Style="{DynamicResource CardTile}" Visibility="Collapsed"
                    Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Ссылка, список ссылок, конфигурация или адрес подписки"
                               Foreground="{DynamicResource TextDim}" Margin="2,0,0,7" TextWrapping="Wrap" />
                    <TextBox x:Name="ImportBox" Style="{DynamicResource Field}" MinHeight="58" MaxHeight="96"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" PreviewKeyDown="OnImportKeyDown"
                             AutomationProperties.Name="Ссылка на сервер или подписку" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Style="{StaticResource PickerAction}" Content="Закрыть" Click="OnHideImport" />
                        <Button x:Name="ImportBtn" Style="{DynamicResource BtnPrimary}" Padding="12,5"
                                Content="Импортировать" Click="OnImport" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,8">
                <TextBox x:Name="SearchBox" Style="{DynamicResource Field}" Padding="11,6"
                         TextChanged="OnSearchChanged" AutomationProperties.Name="Поиск серверов" />
                <TextBlock Text="Поиск по имени, стране, адресу или протоколу" Margin="12,0,10,0"
                           Foreground="{DynamicResource TextDim}" IsHitTestVisible="False" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <WrapPanel>
                <Button x:Name="PingAllBtn" Style="{StaticResource PickerAction}"
                        Content="Замерить задержку" Click="OnPingAll" />
                <Button x:Name="CheckBtn" Style="{StaticResource PickerAction}"
                        Content="Проверить трафик" Click="OnCheckAll"
                        ToolTip="Проверяет запрос через каждый сервер Xray" />
                <Button x:Name="RefreshBtn" Style="{StaticResource PickerAction}"
                        Content="Обновить подписки" Click="OnRefreshSubs" />
            </WrapPanel>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0"
                Padding="18,10">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" x:Name="BestBtn" Style="{DynamicResource BtnPrimary}"
                        Padding="12,7" Margin="10,0,0,0" Content="Подключить лучший" Click="OnPickBest" />
                <Button DockPanel.Dock="Right" x:Name="CancelBtn" Style="{DynamicResource Btn}" Padding="10,6"
                        Margin="10,0,0,0" Content="Отменить" Visibility="Collapsed" Click="OnCancelOperation" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" Foreground="{DynamicResource TextDim}" FontSize="11" />
                    <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource Text}" FontSize="12" Margin="0,2,0,0"
                               TextWrapping="Wrap" MaxHeight="52" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="18,2,18,8">
                <ItemsControl x:Name="ServerList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource CardTile}" Padding="7,7" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="7,2,2,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text}" />
                                            <TextBlock Text="{Binding Details}" Margin="0,3,0,0" FontSize="11"
                                                       TextWrapping="Wrap" Foreground="{DynamicResource TextDim}"
                                                       Visibility="{Binding HasDetails, Converter={StaticResource VisibleIf}}" />
                                            <ProgressBar Style="{StaticResource QuotaProgress}"
                                                         Value="{Binding UsedFraction, Mode=OneWay}" Maximum="1"
                                                         Height="3" Width="140" Margin="0,5,0,0" HorizontalAlignment="Left"
                                                         Visibility="{Binding HasQuota, Converter={StaticResource VisibleIf}}"
                                                         AutomationProperties.Name="Доля использованного трафика подписки" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding IsSubscription, Converter={StaticResource VisibleIf}}">
                                            <Button Style="{StaticResource PickerAction}" FontFamily="Segoe MDL2 Assets" Content="&#xE72C;"
                                                    ToolTip="Обновить подписку" AutomationProperties.Name="Обновить подписку"
                                                    Click="OnRefreshSubscription" />
                                            <Button Style="{StaticResource PickerAction}" FontFamily="Segoe MDL2 Assets" Content="&#xE74D;"
                                                    ToolTip="Удалить подписку" AutomationProperties.Name="Удалить подписку"
                                                    Click="OnRemoveSubscription" />
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Servers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Style="{StaticResource ServerSelection}" Click="OnSelectServer"
                                                            AutomationProperties.Name="{Binding Row.Name}" IsEnabled="{Binding CanConnect}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse Width="7" Height="7" Margin="1,0,10,0"
                                                                     Fill="{Binding Row.DotBrush}" />
                                                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding Row.Name}" FontSize="13" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Subtitle}" Margin="0,2,0,0" FontSize="11"
                                                                           Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding Row.Ping}" FontSize="11"
                                                                       FontFamily="{StaticResource MetricFont}" Foreground="{Binding Row.PingBrush}"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Button>
                                                    <Button Grid.Column="1" Style="{StaticResource PickerAction}" VerticalAlignment="Center"
                                                            Content="Подключить" Click="OnConnectServer" IsEnabled="{Binding CanConnect}" />
                                                    <Button Grid.Column="2" Style="{StaticResource PickerAction}" VerticalAlignment="Center"
                                                            FontFamily="Segoe MDL2 Assets" Content="&#xE74D;" Click="OnRemoveServer"
                                                            ToolTip="Удалить сервер" AutomationProperties.Name="Удалить сервер"
                                                            Visibility="{Binding CanRemove, Converter={StaticResource VisibleIf}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" Margin="30" Foreground="{DynamicResource TextDim}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" IsHitTestVisible="False" />
        </Grid>
    </DockPanel>
</local:AnemiaToolWindow>
