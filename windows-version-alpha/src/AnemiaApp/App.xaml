<Application x:Class="AnemiaApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AnemiaApp"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Warm Anemia theme, ported from the macOS Theme.swift. Both
             palettes are first-class; App.ApplyTheme(dark) swaps the brush
             values live (every consumer binds DynamicResource), so following
             the system light/dark setting costs no view-level branching.
             Default values below are the LIGHT palette. -->
        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FAF9F5" Offset="0" />
            <GradientStop Color="#F0EEE6" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Ground" Color="#FAF9F5" />
        <SolidColorBrush x:Key="MapLand" Color="#29141413" />
        <SolidColorBrush x:Key="Card" Color="#E0FFFFFF" />
        <SolidColorBrush x:Key="CardHi" Color="#F7FFFFFF" />
        <SolidColorBrush x:Key="Stroke" Color="#1A141413" />
        <SolidColorBrush x:Key="EdgeHi" Color="#D9FFFFFF" />
        <SolidColorBrush x:Key="EdgeLo" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="Text" Color="#FF141413" />
        <SolidColorBrush x:Key="TextDim" Color="#FF6E6D68" />
        <SolidColorBrush x:Key="Accent" Color="#FFD97757" />
        <SolidColorBrush x:Key="AccentDim" Color="#FFC96442" />
        <SolidColorBrush x:Key="Idle" Color="#0F141413" />
        <LinearGradientBrush x:Key="PillSurface" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFEFA" Offset="0" />
            <GradientStop Color="#F5F2EB" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PillRim" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#D8D4CA" Offset="0" />
            <GradientStop Color="#E5E1D7" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ProtectionAccentTile" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#DE896E" Offset="0" />
            <GradientStop Color="#BB6043" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ProtectionAccentInk" Color="#FEF9F7" />
        <SolidColorBrush x:Key="SwitchTrack" Color="#D6D2C9" />
        <SolidColorBrush x:Key="ToolbarSwitchTrack" Color="#E1DED5" />
        <SolidColorBrush x:Key="ToolbarSwitchEdge" Color="#B7B3AA" />
        <SolidColorBrush x:Key="ToolbarSwitchKnob" Color="#FCFBF8" />
        <SolidColorBrush x:Key="Danger" Color="#FFB8442F" />
        <SolidColorBrush x:Key="Warn" Color="#FFB7791F" />
        <SolidColorBrush x:Key="Good" Color="#FFD97757" />

        <!-- Display voice (macOS: New York serif) — Georgia is its nearest
             Windows neighbour; metrics are monospaced so ticking values
             don't jitter their own layout. -->
        <FontFamily x:Key="DisplayFont">Georgia</FontFamily>
        <FontFamily x:Key="MetricFont">Consolas</FontFamily>

        <Style x:Key="WindowCaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style TargetType="Control">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Border Margin="4" BorderThickness="1" CornerRadius="4"
                                            BorderBrush="{DynamicResource Accent}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHi}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Card}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WindowMaximizeCaptionButton" TargetType="Button" BasedOn="{StaticResource WindowCaptionButton}">
            <Setter Property="Content" Value="&#xE922;" />
            <Setter Property="ToolTip" Value="Развернуть" />
            <Setter Property="AutomationProperties.Name" Value="Развернуть" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="Content" Value="&#xE923;" />
                    <Setter Property="ToolTip" Value="Восстановить размер" />
                    <Setter Property="AutomationProperties.Name" Value="Восстановить размер" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WindowCloseCaptionButton" TargetType="Button" BasedOn="{StaticResource WindowCaptionButton}">
            <Setter Property="Content" Value="&#xE8BB;" />
            <Setter Property="ToolTip" Value="Закрыть" />
            <Setter Property="AutomationProperties.Name" Value="Закрыть" />
        </Style>
        <Style x:Key="AnemiaToolWindow" TargetType="local:AnemiaToolWindow">
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ShowInTaskbar" Value="False" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Background" Value="{DynamicResource Ground}" />
            <Setter Property="shell:WindowChrome.WindowChrome">
                <Setter.Value>
                    <shell:WindowChrome CaptionHeight="26" ResizeBorderThickness="6" GlassFrameThickness="0"
                                        CornerRadius="32" UseAeroCaptionButtons="False" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:AnemiaToolWindow">
                        <AdornerDecorator>
                        <Border x:Name="toolFrame" CornerRadius="16" BorderThickness="1"
                                BorderBrush="{DynamicResource Stroke}" Background="{TemplateBinding Background}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Height="32">
                                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <Rectangle Width="14" Height="14" Fill="{DynamicResource Accent}">
                                            <Rectangle.OpacityMask>
                                                <ImageBrush ImageSource="/Anemia;component/Assets/anemia-mark.png" Stretch="Uniform" />
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <TextBlock x:Name="captionTitle" Text="{TemplateBinding Title}" Visibility="Collapsed"
                                                   Margin="6,0,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button x:Name="minimizeCaption" Style="{StaticResource WindowCaptionButton}" Content="&#xE921;"
                                                AutomationProperties.Name="Свернуть" ToolTip="Свернуть"
                                                Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                        <Button x:Name="maximizeCaption" Style="{StaticResource WindowMaximizeCaptionButton}"
                                                Command="{x:Static local:AnemiaToolWindow.ToggleMaximizeCommand}"
                                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                        <Button x:Name="closeCaption" Style="{StaticResource WindowCloseCaptionButton}"
                                                Command="{x:Static SystemCommands.CloseWindowCommand}"
                                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                                    </StackPanel>
                                </Grid>
                                <ContentPresenter ContentSource="Content" />
                            </DockPanel>
                        </Border>
                        </AdornerDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ShowCaptionTitle" Value="True">
                                <Setter TargetName="captionTitle" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="WindowState" Value="Maximized">
                                <Setter TargetName="toolFrame" Property="CornerRadius" Value="0" />
                            </Trigger>
                            <Trigger Property="ResizeMode" Value="NoResize">
                                <Setter TargetName="minimizeCaption" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="maximizeCaption" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="ResizeMode" Value="CanMinimize">
                                <Setter TargetName="maximizeCaption" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="ResizeMode" Value="NoResize">
                    <Setter Property="shell:WindowChrome.WindowChrome">
                        <Setter.Value>
                            <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0"
                                                CornerRadius="32" UseAeroCaptionButtons="False" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Display" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        </Style>

        <!-- Grouped controls share a single surface and hairlines. -->
        <Style x:Key="CardTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdgeHi}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="15" />
        </Style>
        <!-- Sub-tile (server card, action buttons): same language, smaller radius. -->
        <Style x:Key="SubTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdgeHi}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="Hairline" TargetType="Rectangle">
            <Setter Property="Fill" Value="{DynamicResource Stroke}" />
            <Setter Property="Height" Value="1" />
        </Style>

        <Style x:Key="ProtectionIcon" TargetType="Border">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Idle}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextDim}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ProtectionAccentTile}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource ProtectionAccentInk}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Idle}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="13">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost quick-action / tile button. -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdgeHi}" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="13" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHi}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Idle}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{DynamicResource PillSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PillRim}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="24"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="caption" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="surface" Property="Background" Value="{DynamicResource CardHi}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="surface" Property="Background" Value="{DynamicResource Card}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="surface" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="caption" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filled CTA (Import etc.). -->
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{DynamicResource AccentDim}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="13" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The connect toggle (macOS: switch). Track goes terracotta when on. -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="46" Height="27">
                            <Border x:Name="track" CornerRadius="13.5"
                                    Background="{DynamicResource SwitchTrack}"
                                    BorderBrush="{DynamicResource Stroke}" BorderThickness="1" />
                            <Ellipse x:Name="thumb" Width="21" Height="21" Fill="White"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="2,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentDim}" />
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource AccentDim}" />
                                <Setter TargetName="thumb" Property="Margin" Value="23,0,0,0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless combo for the masking row: text + chevron, quiet fill. -->
        <Style x:Key="MiniCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{DynamicResource Idle}" CornerRadius="13" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,6,22,6" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource TextDim}" StrokeThickness="1.5"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                                  IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Placement="Bottom" StaysOpen="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource CardHi}" BorderBrush="{DynamicResource Stroke}"
                                        BorderThickness="1" CornerRadius="10" Margin="0,4,8,8" Padding="4"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18" />
                                    </Border.Effect>
                                    <ItemsPresenter />
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Idle}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
