<Application x:Class="AnemiaApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Warm Anemia theme, ported from the macOS Theme.swift. Both
             palettes are first-class; App.ApplyTheme(dark) swaps the brush
             values live (every consumer binds DynamicResource), so following
             the system light/dark setting costs no view-level branching.
             Default values below are the LIGHT palette. -->
        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FAF9F5" Offset="0" />
            <GradientStop Color="#F0EEE6" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Card" Color="#E0FFFFFF" />
        <SolidColorBrush x:Key="CardHi" Color="#F7FFFFFF" />
        <SolidColorBrush x:Key="Stroke" Color="#1A141413" />
        <SolidColorBrush x:Key="EdgeHi" Color="#D9FFFFFF" />
        <SolidColorBrush x:Key="EdgeLo" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="Text" Color="#FF141413" />
        <SolidColorBrush x:Key="TextDim" Color="#FF6E6D68" />
        <SolidColorBrush x:Key="Accent" Color="#FFD97757" />
        <SolidColorBrush x:Key="AccentDim" Color="#FFC96442" />
        <SolidColorBrush x:Key="Idle" Color="#0F141413" />
        <SolidColorBrush x:Key="Danger" Color="#FFB8442F" />
        <SolidColorBrush x:Key="Warn" Color="#FFB7791F" />
        <SolidColorBrush x:Key="Good" Color="#FFD97757" />
        <DropShadowEffect x:Key="CardShadow" BlurRadius="11" ShadowDepth="4" Direction="270" Opacity="0.10" />

        <!-- Display voice (macOS: New York serif) — Georgia is its nearest
             Windows neighbour; metrics are monospaced so ticking values
             don't jitter their own layout. -->
        <FontFamily x:Key="DisplayFont">Georgia</FontFamily>
        <FontFamily x:Key="MetricFont">Consolas</FontFamily>

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Display" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        </Style>

        <!-- Grouped tile: soft fill, specular top edge, gentle shadow. -->
        <Style x:Key="CardTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdgeHi}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="Effect" Value="{DynamicResource CardShadow}" />
        </Style>
        <!-- Sub-tile (server card, action buttons): same language, smaller radius. -->
        <Style x:Key="SubTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdgeHi}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
        </Style>
        <Style x:Key="Hairline" TargetType="Rectangle">
            <Setter Property="Fill" Value="{DynamicResource Stroke}" />
            <Setter Property="Height" Value="1" />
        </Style>

        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Idle}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="13">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost quick-action / tile button. -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdgeHi}" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="13" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHi}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filled CTA (Import etc.). -->
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{DynamicResource AccentDim}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="13" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The connect toggle (macOS: switch). Track goes terracotta when on. -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="46" Height="27">
                            <Border x:Name="track" CornerRadius="13.5"
                                    Background="{DynamicResource Idle}"
                                    BorderBrush="{DynamicResource Stroke}" BorderThickness="1" />
                            <Ellipse x:Name="thumb" Width="21" Height="21" Fill="White"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="2,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentDim}" />
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource AccentDim}" />
                                <Setter TargetName="thumb" Property="Margin" Value="23,0,0,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless combo for the masking row: text + chevron, quiet fill. -->
        <Style x:Key="MiniCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{DynamicResource Idle}" CornerRadius="13" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,6,22,6" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}" />
                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource TextDim}" StrokeThickness="1.5"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                                  IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Placement="Bottom" StaysOpen="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource CardHi}" BorderBrush="{DynamicResource Stroke}"
                                        BorderThickness="1" CornerRadius="10" Margin="0,4,8,8" Padding="4"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18" />
                                    </Border.Effect>
                                    <ItemsPresenter />
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Idle}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>