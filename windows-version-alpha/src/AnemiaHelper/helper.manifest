<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity name="Anemia.Windows.Helper" type="win32" version="1.0.0.0" />
  <!--
    The helper does privileged work (routes, firewall policy) on behalf of the
    unprivileged app, so it requests elevation. UAC prompts once, when the app
    first brings up a TUN tunnel.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
