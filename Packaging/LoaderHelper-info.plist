<?xml version="1.0" encoding="UTF-8"?>
<!-- Embedded in the helper binary's __TEXT,__info_plist section (SMJobBless).
     SMAuthorizedClients restricts which signed app may install/talk to it. -->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.loader.vpn.helper</string>
    <key>CFBundleName</key>
    <string>Loader VPN Helper</string>
    <key>CFBundleVersion</key>
    <string>0.1.0</string>
    <key>SMAuthorizedClients</key>
    <array>
        <string>anchor apple generic and identifier "com.loader.vpn" and certificate leaf[subject.OU] = "YOUR_TEAM_ID"</string>
    </array>
</dict>
</plist>
